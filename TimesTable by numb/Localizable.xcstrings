    "All classes and tasks will be permanently deleted. This cannot be undone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le lezioni e i compiti verranno eliminati permanentemente. Questa azione è irreversibile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las clases y tareas se eliminarán permanentemente. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les classes et tâches seront définitivement supprimées. Cela ne peut pas être annulé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Klassen und Aufgaben werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "App onboarding flags have been reset. Close and reopen the app to view the Welcome Screen!": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I flag di onboarding dell'app sono stati reimpostati. Chiudi e riapri l'app per visualizzare la schermata di benvenuto!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han restablecido los indicadores de incorporación de aplicaciones. ¡Cierra y vuelve a abrir la aplicación para ver la pantalla de bienvenida!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indicateurs d’intégration des applications ont été réinitialisés. Fermez et rouvrez l'application pour afficher l'écran de bienvenue !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Onboarding-Flags wurden zurückgesetzt. Schließen Sie die App und öffnen Sie sie erneut, um den Willkommensbildschirm anzuzeigen!"
          }
        }
      }
    },
